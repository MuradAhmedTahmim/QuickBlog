# Copy this file to .env and fill in real values. Never commit .env itself.

# Any long random string - signs the login tokens
JWT_SECRET =

# The admin account used to sign in at /admin
ADMIN_EMAIL =
ADMIN_PASSWORD =

# MongoDB Atlas connection string, without a trailing database name.
# The app appends /quickblog itself.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_URI =

# ImageKit -> Developer options
IMAGEKIT_PUBLIC_KEY =
IMAGEKIT_PRIVATE_KEY =
IMAGEKIT_URL_ENDPOINT =

# Google AI Studio API key, used for the "Generate with AI" button
GEMINI_API_KEY =
