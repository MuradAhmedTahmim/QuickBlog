# QuickBlog - Express API configuration
#
# This is the ONLY example config in the project. Copy it to `.env` in this same
# folder and replace every CHANGE_ME with a real value. `.env` is git-ignored
# and must never be committed.
#
#   cp .env.example .env
#
# The React client needs one variable of its own (VITE_BASE_URL). It has no
# example file; see HowToSetup.md, "Client configuration", for how to set it.


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. 3000 is what the client and docker-compose expect.
PORT = 3000

# Comma-separated list of sites allowed to call this API (CORS allow-list).
# Leave it empty to accept any origin, which is the convenient default for
# local development. Always set it in production.
# Example: CLIENT_URL = https://quickblog.example.com,http://localhost:5173
CLIENT_URL =


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string WITHOUT a trailing database name - the app appends
# `/quickblog` itself.
#   local:  mongodb://127.0.0.1:27017
#   docker: mongodb://mongo:27017
#   atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI = CHANGE_ME


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs the login tokens. Any long random string; rotating it signs everyone
# out. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET = CHANGE_ME

# How long a login lasts. Accepts '30d', '12h', '45m'. Defaults to 30d.
JWT_EXPIRES_IN = 30d

# The first admin. On every start the API creates this account if it is missing
# and keeps its password in step with what is set here.
ADMIN_EMAIL = CHANGE_ME
ADMIN_PASSWORD = CHANGE_ME


# ---------------------------------------------------------------------------
# Google Gemini - powers the "Generate with AI" draft button
# ---------------------------------------------------------------------------

# Key from Google AI Studio (https://aistudio.google.com/apikey).
# Without it the app runs fine; only AI drafting returns an error.
GEMINI_API_KEY = CHANGE_ME


# ---------------------------------------------------------------------------
# ImageKit - stores and transforms article thumbnails and avatars
# ---------------------------------------------------------------------------

# All three come from the ImageKit dashboard -> Developer options -> API keys.
IMAGEKIT_PUBLIC_KEY = CHANGE_ME
IMAGEKIT_PRIVATE_KEY = CHANGE_ME
# Example: https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_URL_ENDPOINT = CHANGE_ME
